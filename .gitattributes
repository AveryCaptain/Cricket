# 统一换行策略：跨端（Windows/iOS/Linux CI）协作防 churn
* text=auto

# 源码与文档强制 LF
*.rs   text eol=lf
*.toml text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sh   text eol=lf
*.swift text eol=lf

# Windows 专有脚本保留 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 二进制
*.png  binary
*.jpg  binary
*.woff2 binary
*.ttf  binary
*.xcframework/** binary
